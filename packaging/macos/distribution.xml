<?xml version="1.0" encoding="utf-8"?>
<!--
  whysho SY1 (synthesizer) macOS installer distribution definition (productbuild).

  This is a TEMPLATE. scripts/build-macos-installer.sh substitutes the
  __VERSION__ tokens, then runs productbuild with this file as the
  distribution, a resources directory and the directory holding the
  component packages, producing WhyshoSY1-<version>-macOS.pkg.

  Resource files (welcome.html, conclusion.html, license.txt) live in the
  resources directory. license.txt is a copy of packaging/EULA.txt.

  Note: XML comments must not contain a double hyphen, so command-line
  flags are deliberately not spelled out here; see the script.
-->
<installer-gui-script minSpecVersion="2">
    <title>whysho SY1</title>

    <!-- Universal2: install on both Intel and Apple Silicon. -->
    <options customize="allow" require-scripts="false" rootVolumeOnly="true"
             hostArchitectures="x86_64,arm64"/>

    <!-- macOS 11 (Big Sur) or newer. -->
    <volume-check>
        <allowed-os-versions>
            <os-version min="11.0"/>
        </allowed-os-versions>
    </volume-check>

    <!-- Wizard panes. welcome + license (the EULA) are shown to the user. -->
    <welcome file="welcome.html" mime-type="text/html"/>
    <license file="license.txt" mime-type="text/plain"/>
    <conclusion file="conclusion.html" mime-type="text/html"/>
    <!-- Optional: drop a background.png into packaging/macos/ to enable this.
         <background file="background.png" mime-type="image/png"
                     alignment="bottomleft" scaling="proportional"/> -->

    <!-- Component package references (ids match the identifiers given to pkgbuild). -->
    <pkg-ref id="com.whysho.sy1.vst3"/>
    <pkg-ref id="com.whysho.sy1.au"/>

    <choices-outline>
        <line choice="choice_vst3"/>
        <line choice="choice_au"/>
    </choices-outline>

    <choice id="choice_vst3" title="VST3 Instrument"
            description="Install the whysho SY1 synthesizer as a VST3 instrument to /Library/Audio/Plug-Ins/VST3.">
        <pkg-ref id="com.whysho.sy1.vst3"/>
    </choice>

    <choice id="choice_au" title="Audio Unit (AU) Instrument"
            description="Install the whysho SY1 synthesizer as an Audio Unit instrument to /Library/Audio/Plug-Ins/Components (Logic Pro, GarageBand, MainStage).">
        <pkg-ref id="com.whysho.sy1.au"/>
    </choice>

    <pkg-ref id="com.whysho.sy1.vst3" version="__VERSION__" onConclusion="none">WhyshoSY1-VST3.pkg</pkg-ref>
    <pkg-ref id="com.whysho.sy1.au" version="__VERSION__" onConclusion="none">WhyshoSY1-AU.pkg</pkg-ref>
</installer-gui-script>
