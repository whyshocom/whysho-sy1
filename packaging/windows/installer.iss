; =============================================================================
;  whysho SY1 — Windows installer (Inno Setup 6)
; =============================================================================
;
;  This script packages the SY1 synthesizer — the VST3 instrument plug-in and
;  the Standalone application — into a single Windows installer (.exe).
;
;  It is driven by preprocessor defines that scripts/build-windows-installer.ps1
;  passes on the ISCC command line, e.g.:
;
;    ISCC.exe /DAppVersion=1.2.3 ^
;             /DBuildDir="C:\path\to\build" ^
;             /DRepoRoot="C:\path\to\repo" ^
;             /DOutputDir="C:\path\to\dist" ^
;             packaging\windows\installer.iss
;
;  Any define left unset falls back to a sensible default resolved relative to
;  this script's own location ({#SourcePath}), so the file can also be opened
;  and compiled directly from the Inno Setup IDE for local testing.
; =============================================================================

#ifndef AppVersion
  #define AppVersion "0.1.0"
#endif

; Repo root (default: two levels up from packaging\windows\).
#ifndef RepoRoot
  #define RepoRoot AddBackslash(SourcePath) + "..\.."
#endif

; Build output tree (default: <RepoRoot>\build).
#ifndef BuildDir
  #define BuildDir AddBackslash(RepoRoot) + "build"
#endif

; Where the finished installer .exe is written (default: <RepoRoot>\dist).
#ifndef OutputDir
  #define OutputDir AddBackslash(RepoRoot) + "dist"
#endif

; EULA shown on the license page.
#ifndef LicenseFile
  #define LicenseFile AddBackslash(RepoRoot) + "packaging\EULA.txt"
#endif

#define AppName       "whysho SY1"
#define AppPublisher  "whysho"
#define AppURL        "https://whysho.com"
#define AppExeName    "whysho SY1.exe"
; Installer artwork (generated by packaging/art/make_art.py).
#define ArtDir        AddBackslash(RepoRoot) + "packaging\windows"
; JUCE artefact locations under the build tree.
#define ArtefactsDir  AddBackslash(BuildDir) + "WhyshoSY1_artefacts\Release"
#define Vst3Bundle    AddBackslash(ArtefactsDir) + "VST3\whysho SY1.vst3"
#define StandaloneExe AddBackslash(ArtefactsDir) + "Standalone\whysho SY1.exe"

[Setup]
; A stable AppId (GUID) so upgrades and uninstall work across versions. It is
; unique to SY1: sharing one with another whysho product would make the two
; installers upgrade and uninstall each other. Never change it once released.
AppId={{B86F09AC-6453-4469-A3A6-4307C6734357}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher={#AppPublisher}
AppPublisherURL={#AppURL}
AppSupportURL={#AppURL}
AppUpdatesURL={#AppURL}
VersionInfoVersion={#AppVersion}
; Publisher shown in Apps & features and in the installer's file properties.
; The "Verified publisher" line in the Windows UAC prompt comes from the
; code-signing certificate, not from here: see packaging/README.md.
VersionInfoCompany={#AppPublisher}
VersionInfoProductName={#AppName}
VersionInfoProductVersion={#AppVersion}
VersionInfoDescription={#AppName} Setup
VersionInfoCopyright=(c) {#AppPublisher}
AppCopyright=(c) {#AppPublisher}

DefaultDirName={autopf}\{#AppPublisher}\{#AppName}
DefaultGroupName={#AppPublisher}
DisableProgramGroupPage=yes
LicenseFile={#LicenseFile}

; 64-bit only (Windows 10+ x64).
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
MinVersion=10.0

; Modern wizard UI in the whysho "signal paper" look (colours are applied in
; [Code] below), and a clean uninstaller entry.
WizardStyle=modern
WizardImageFile={#ArtDir}\wizard-large-1x.bmp,{#ArtDir}\wizard-large-2x.bmp
WizardSmallImageFile={#ArtDir}\wizard-small-1x.bmp,{#ArtDir}\wizard-small-2x.bmp
WizardImageStretch=yes
SetupIconFile={#ArtDir}\setup.ico
DisableWelcomePage=no
ShowLanguageDialog=no
UninstallDisplayName={#AppName} {#AppVersion}
UninstallDisplayIcon={app}\{#AppExeName}
Compression=lzma2/max
SolidCompression=yes
PrivilegesRequired=admin

OutputDir={#OutputDir}
OutputBaseFilename=WhyshoSY1-{#AppVersion}-Windows

[Languages]
Name: "english"; MessagesFile: "compiler:Default.isl"

[Messages]
; Brand voice: lowercase "whysho", short sentences.
WelcomeLabel1=whysho SY1
WelcomeLabel2=A straightforward synthesizer.%n%nThis sets up SY1 [name/ver] on your computer: the VST3 instrument for your DAW, and a standalone app.%n%nClose your DAW before you continue.
FinishedHeadingLabel=SY1 is installed
FinishedLabelNoIcons=Open your DAW and rescan plug-ins. SY1 appears among your instruments.%n%nSign in with your whysho account inside the plug-in to unlock it.
FinishedLabel=Open your DAW and rescan plug-ins. SY1 appears among your instruments.%n%nSign in with your whysho account inside the plug-in to unlock it.

[Types]
Name: "full";   Description: "Full installation"
Name: "custom"; Description: "Custom installation"; Flags: iscustom

[Components]
Name: "vst3";       Description: "VST3 instrument (for your DAW)";            Types: full custom; Flags: checkablealone
Name: "standalone"; Description: "Standalone application (play without a DAW)"; Types: full custom

[Tasks]
Name: "desktopicon"; Description: "{cm:CreateDesktopIcon}"; GroupDescription: "{cm:AdditionalIcons}"; Components: standalone; Flags: unchecked

[Files]
; --- VST3 instrument bundle -> C:\Program Files\Common Files\VST3 -----------------
; The .vst3 is a bundle (a directory tree); install it recursively.
Source: "{#Vst3Bundle}\*"; DestDir: "{commoncf64}\VST3\{#AppName}.vst3"; \
    Components: vst3; Flags: ignoreversion recursesubdirs createallsubdirs

; --- Standalone application -> Program Files -----------------------------------
Source: "{#StandaloneExe}"; DestDir: "{app}"; DestName: "{#AppExeName}"; \
    Components: standalone; Flags: ignoreversion

[Icons]
; Start Menu shortcut for the Standalone app.
Name: "{group}\{#AppName}"; Filename: "{app}\{#AppExeName}"; Components: standalone
Name: "{group}\Uninstall {#AppName}"; Filename: "{uninstallexe}"
; Optional desktop shortcut (controlled by the [Tasks] entry above).
Name: "{autodesktop}\{#AppName}"; Filename: "{app}\{#AppExeName}"; Components: standalone; Tasks: desktopicon

[Run]
Filename: "{app}\{#AppExeName}"; Description: "{cm:LaunchProgram,{#StringChange(AppName, '&', '&&')}}"; \
    Flags: nowait postinstall skipifsilent; Components: standalone

[UninstallDelete]
; Remove the VST3 bundle directory on uninstall (recursesubdirs leaves the folder).
Type: filesandordirs; Name: "{commoncf64}\VST3\{#AppName}.vst3"

[Code]
// Paint the wizard in the whysho paper palette (same tokens as whysho.com and
// the plug-in's Paper theme). Colours are $BBGGRR.
const
  clPaper   = $E0ECF1;  // #F1ECE0
  clPaperHi = $EAF4F8;  // #F8F4EA
  clInk     = $13181B;  // #1B1813
  clInkSoft = $43525A;  // #5A5243
  clPinkInk = $6A00B0;  // #B0006A  (pink dark enough for text on paper)

procedure InitializeWizard;
begin
  WizardForm.Color := clPaper;
  WizardForm.Font.Color := clInk;

  // Welcome / finished pages (image on the left, text on paper).
  WizardForm.WelcomePage.Color := clPaper;
  WizardForm.FinishedPage.Color := clPaper;
  WizardForm.WelcomeLabel1.Font.Color := clInk;
  WizardForm.WelcomeLabel1.Font.Style := [fsBold];
  WizardForm.WelcomeLabel1.Font.Size := 16;
  WizardForm.WelcomeLabel2.Font.Color := clInkSoft;
  WizardForm.FinishedHeadingLabel.Font.Color := clInk;
  WizardForm.FinishedHeadingLabel.Font.Style := [fsBold];
  WizardForm.FinishedHeadingLabel.Font.Size := 16;
  WizardForm.FinishedLabel.Font.Color := clInkSoft;

  // Inner pages: paper body, lighter header strip and fields.
  WizardForm.InnerPage.Color := clPaper;
  WizardForm.MainPanel.Color := clPaperHi;
  WizardForm.PageNameLabel.Font.Color := clInk;
  WizardForm.PageDescriptionLabel.Font.Color := clPinkInk;
  WizardForm.LicenseMemo.Color := clPaperHi;
  WizardForm.ComponentsList.Color := clPaperHi;
  WizardForm.TasksList.Color := clPaper;
  WizardForm.ReadyMemo.Color := clPaperHi;
  WizardForm.DirEdit.Color := clPaperHi;
end;
